diff --git a/store/durability_test.go b/store/durability_test.go
new file mode 100644
index 0000000..8e48d86
--- /dev/null
+++ b/store/durability_test.go
@@ -0,0 +1,21 @@
+package store
+
+import (
+	"path/filepath"
+	"testing"
+)
+
+func TestClosedWrapperRequiresDurableSQLiteCommits(t *testing.T) {
+	s, err := OpenSQLite(filepath.Join(t.TempDir(), "state.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	var policy int
+	if err = s.db.QueryRow("PRAGMA synchronous").Scan(&policy); err != nil {
+		t.Fatal(err)
+	}
+	if policy != 2 {
+		t.Fatalf("SQLite synchronous policy = %d; want FULL (2)", policy)
+	}
+}
