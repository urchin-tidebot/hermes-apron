new file mode 100644
index 0000000..f38f3e9
--- /dev/null
+++ b/apron/closed_timers_test.go
@@ -0,0 +1,54 @@
+package apron
+
+import (
+	"context"
+	"crypto/rand"
+	"github.com/go-webauthn/webauthn/webauthn"
+	"testing"
+	"time"
+)
+
+func TestMachineTimerLifecycle(t *testing.T) {
+	var e *Enrollment
+	cfg := extensionConfig(testExtension{"closed", func(r *Registrar) error {
+		var err error
+		e, err = r.ClosedEnrollment()
+		if err != nil {
+			return err
+		}
+		if _, err = r.Bot("hermes", BotOptions{}); err != nil {
+			return err
+		}
+		return e.BindMachine("hermes", rand.Text()+rand.Text(), time.Hour, []string{"general"})
+	}})
+	cfg.WebAuthn, _ = webauthn.New(&webauthn.Config{RPID: "localhost", RPDisplayName: "Test", RPOrigins: []string{"http://localhost"}})
+	s, _ := newTestServer(t, cfg)
+	timer := func() *time.Timer { s.mu.RLock(); defer s.mu.RUnlock(); return e.machineTimers["hermes"] }
+	old := timer()
+	if old == nil {
+		t.Fatal("binding has no expiry timer")
+	}
+	if err := e.BindMachine("hermes", rand.Text()+rand.Text(), time.Hour, []string{"general"}); err != nil {
+		t.Fatal(err)
+	}
+	if timer() == old || old.Stop() {
+		t.Fatal("rotation retained its old timer")
+	}
+	current := timer()
+	if err := e.RevokeAccount("hermes"); err != nil {
+		t.Fatal(err)
+	}
+	if timer() != nil || current.Stop() {
+		t.Fatal("revocation retained its timer")
+	}
+	if err := e.BindMachine("hermes", rand.Text()+rand.Text(), time.Hour, []string{"general"}); err != nil {
+		t.Fatal(err)
+	}
+	current = timer()
+	if err := s.Shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if timer() != nil || current.Stop() {
+		t.Fatal("shutdown retained its timer")
+	}
+}
