diff --git a/apron/closed.go b/apron/closed.go
new file mode 100644
index 0000000..aa7464a
--- /dev/null
+++ b/apron/closed.go
@@ -0,0 +1,300 @@
+package apron
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json/jsontext"
+	"encoding/json/v2"
+	"errors"
+	"slices"
+	"time"
+)
+
+// Enrollment is an isolated hermes-apron patch API. It owns a restrictive
+// immutable-ID allowlist and stores policy alongside upstream accounts, in the
+// SAME store batch. No policy callbacks execute inside the authentication lock.
+type Enrollment struct {
+	host          *Host
+	list          *Allowlist
+	state         enrollmentState
+	machineTimers map[string]*time.Timer
+}
+type enrollmentState struct {
+	Invitations map[string]enrollmentInvite  `json:"invitations"`
+	Machines    map[string]machineCredential `json:"machines"`
+	Accounts    map[string]bool              `json:"accounts"` // bool is explicit owner role
+}
+type machineCredential struct {
+	UserID  string    `json:"user_id"`
+	Expires time.Time `json:"expires"`
+	Revoked bool      `json:"revoked"`
+	Rooms   []string  `json:"rooms"`
+}
+type enrollmentInvite struct {
+	Expires time.Time `json:"expires"`
+	Owner   bool      `json:"owner"`
+	Used    bool      `json:"used"`
+}
+
+func (r *Registrar) ClosedEnrollment() (*Enrollment, error) {
+	e := &Enrollment{host: r.Host, list: r.RestrictSignIn(), machineTimers: make(map[string]*time.Timer)}
+	_, err := r.Store().Get("policy", &e.state)
+	if err != nil {
+		return nil, errors.New("closed enrollment policy is corrupt")
+	}
+	if e.state.Invitations == nil {
+		e.state.Invitations = make(map[string]enrollmentInvite)
+	}
+	if e.state.Accounts == nil {
+		e.state.Accounts = make(map[string]bool)
+	}
+	for id := range e.state.Accounts {
+		if err = e.list.Allow(UserID(id)); err != nil {
+			return nil, err
+		}
+	}
+	if e.state.Machines == nil {
+		e.state.Machines = make(map[string]machineCredential)
+	}
+	r.s.mu.Lock()
+	for _, u := range r.s.users {
+		if u.botOf != "" {
+			u.machinePolicy = e
+		}
+	}
+	r.s.enrollment = e
+	for hash, m := range e.state.Machines {
+		e.scheduleMachineLocked(hash, m)
+	}
+	r.s.unlock()
+	return e, nil
+}
+func invitationHash(token string) string {
+	h := sha256.Sum256([]byte(token))
+	return hex.EncodeToString(h[:])
+}
+
+// Issue returns plaintext only to the local caller. The policy stores a verifier.
+// TTL is positive and at most 15 minutes. Outstanding and spent records are bounded.
+func (e *Enrollment) Issue(ttl time.Duration, owner bool) (string, error) {
+	s := e.host.s
+	s.mu.Lock()
+	defer s.unlock()
+	if ttl <= 0 || ttl > 15*time.Minute || s.storeFailed {
+		return "", errors.New("invitation unavailable")
+	}
+	now := time.Now()
+	for k, v := range e.state.Invitations {
+		if !now.Before(v.Expires) {
+			delete(e.state.Invitations, k)
+		}
+	}
+	if len(e.state.Invitations) >= 256 {
+		return "", errors.New("invitation limit reached")
+	}
+	var secret [32]byte
+	if _, err := rand.Read(secret[:]); err != nil {
+		return "", err
+	}
+	token := base64.RawURLEncoding.EncodeToString(secret[:])
+	e.state.Invitations[invitationHash(token)] = enrollmentInvite{Expires: now.Add(ttl), Owner: owner}
+	if err := e.persistLocked(); err != nil {
+		return "", err
+	}
+	return token, nil
+}
+func (e *Enrollment) persistLocked() error {
+	s := e.host.s
+	kind := "ext/" + e.host.name
+	raw, err := json.Marshal(e.state)
+	if err != nil {
+		return errors.New("policy serialization failed")
+	}
+	if s.extData[kind] == nil {
+		s.extData[kind] = make(map[string]jsontext.Value)
+	}
+	s.extData[kind]["policy"] = raw
+	s.dirty.ext[extKey{kind, "policy"}] = true
+	s.flushLocked()
+	if s.storeFailed {
+		return errors.New("persistence failed; restart required")
+	}
+	return nil
+}
+
+func (e *Enrollment) validLocked(hash string) bool {
+	i, ok := e.state.Invitations[hash]
+	return ok && !i.Used && time.Now().Before(i.Expires) && !e.host.s.storeFailed
+}
+func (e *Enrollment) consumeLocked(hash string, u *userState) error {
+	if !e.validLocked(hash) {
+		return errors.New("invitation unavailable")
+	}
+	s := e.host.s
+	i := e.state.Invitations[hash]
+	i.Used = true
+	e.state.Invitations[hash] = i
+	e.state.Accounts[u.id] = i.Owner
+	s.allowlist.principals[UserID(u.id)] = true
+	if i.Owner {
+		s.setGrantLocked(u, "closed", []string{RoleAdmin})
+		s.grantRolesLocked(u)
+	}
+	return e.persistLocked()
+}
+
+// RevokeInvitation revokes by verifier (the CLI need not read the plaintext).
+func (e *Enrollment) RevokeInvitation(verifier string) error {
+	s := e.host.s
+	s.mu.Lock()
+	defer s.unlock()
+	delete(e.state.Invitations, verifier)
+	return e.persistLocked()
+}
+
+// RevokeAccount removes an immutable ID and all its active bearer/device sessions.
+func (e *Enrollment) RevokeAccount(id string) error {
+	s := e.host.s
+	s.mu.Lock()
+	defer s.unlock()
+	e.stopMachineTimerLocked(id)
+	delete(e.state.Accounts, id)
+	for hash, m := range e.state.Machines {
+		if m.UserID == id {
+			m.Revoked = true
+			e.state.Machines[hash] = m
+		}
+	}
+	delete(s.allowlist.principals, UserID(id))
+	if u := s.users[id]; u != nil {
+		s.signOutLocked(u)
+	}
+	return e.persistLocked()
+}
+
+// BindMachine binds a runtime-only credential to an extension-owned bot.
+func (e *Enrollment) BindMachine(id, token string, ttl time.Duration, rooms []string) error {
+	s := e.host.s
+	s.mu.Lock()
+	defer s.unlock()
+	u := s.users[id]
+	if u == nil || u.botOf != e.host.name || len(token) < 43 || ttl <= 0 || ttl > 7*24*time.Hour {
+		return errors.New("invalid machine binding")
+	}
+
+	if len(rooms) == 0 {
+		return errors.New("machine needs explicit rooms")
+	}
+	for _, id := range rooms {
+		r := s.rooms[id]
+		if r == nil {
+			return errors.New("unknown machine room")
+		}
+		for p := r.parent; p != nil; p = p.parent {
+			if !slices.Contains(rooms, p.id) {
+				return errors.New("machine thread needs explicit parent scope")
+			}
+		}
+	}
+	hash := invitationHash(token)
+	m, existing := e.state.Machines[hash]
+	if existing && m.UserID != id {
+		return errors.New("invalid machine binding")
+	}
+	if !existing {
+		m = machineCredential{UserID: id, Expires: time.Now().Add(ttl)}
+	}
+	m.Rooms = slices.Clone(rooms)
+
+	for key, m := range e.state.Machines {
+		if m.UserID == id {
+			delete(e.state.Machines, key)
+		}
+	}
+	e.stopMachineTimerLocked(id)
+	s.signOutLocked(u)
+	e.state.Machines[hash] = m
+	u.machinePolicy = e
+	e.scheduleMachineLocked(hash, m)
+	// Reconcile under the policy lock, including private rooms. Only this trusted
+	// operator API may grant scope; protocol membership changes cannot expand it.
+	for _, r := range u.joined {
+		if !slices.Contains(rooms, r.id) {
+			s.leaveLocked(u, r)
+		}
+	}
+	if !m.Revoked && time.Now().Before(m.Expires) {
+		pending := slices.Clone(rooms)
+		for len(pending) > 0 {
+			for i, id := range pending {
+				r := s.rooms[id]
+				if r.parent == nil || u.joined[r.parent.id] != nil {
+					s.joinLocked(u, r)
+					pending = slices.Delete(pending, i, i+1)
+					break
+				}
+			}
+		}
+	}
+	return e.persistLocked()
+}
+
+func (e *Enrollment) machineAllowedLocked(id string) bool {
+	for _, m := range e.state.Machines {
+		if m.UserID == id && !m.Revoked && time.Now().Before(m.Expires) {
+			return true
+		}
+	}
+	return false
+}
+
+func (e *Enrollment) machineRoomAllowedLocked(id, room string) bool {
+	for _, m := range e.state.Machines {
+		if m.UserID == id && !m.Revoked && time.Now().Before(m.Expires) && slices.Contains(m.Rooms, room) {
+			return true
+		}
+	}
+	return false
+}
+
+// Every callback takes the policy lock and verifies its timer generation. Stopped
+// callbacks cannot sign out a newly bound credential. No timers survive shutdown.
+func (e *Enrollment) stopMachineTimerLocked(id string) {
+	if timer := e.machineTimers[id]; timer != nil {
+		timer.Stop()
+		delete(e.machineTimers, id)
+	}
+}
+func (e *Enrollment) scheduleMachineLocked(hash string, m machineCredential) {
+	e.stopMachineTimerLocked(m.UserID)
+	if m.Revoked || e.host.s.closed {
+		return
+	}
+	var timer *time.Timer
+	timer = time.AfterFunc(max(0, time.Until(m.Expires)), func() {
+		s := e.host.s
+		s.mu.Lock()
+		defer s.unlock()
+		if s.closed || e.machineTimers[m.UserID] != timer {
+			return
+		}
+		delete(e.machineTimers, m.UserID)
+		if current, ok := e.state.Machines[hash]; ok && !time.Now().Before(current.Expires) {
+			if u := s.users[m.UserID]; u != nil {
+				s.signOutLocked(u)
+			}
+		}
+	})
+	e.machineTimers[m.UserID] = timer
+}
+
+// Check the clock at dispatch too: queued frames cannot race a delayed timer.
+func (s *Server) machineExpiredLocked(c *client) bool {
+	if c.user != nil && c.user.machinePolicy != nil && !c.user.machinePolicy.machineAllowedLocked(c.user.id) {
+		s.signOutLocked(c.user)
+		return true
+	}
+	return false
+}
